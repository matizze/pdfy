{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matizze.com.br/schemas/pdfy/document-1.json",
  "title": "pdfy document",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "title"],
  "properties": {
    "schema": {"const": "1"},
    "title": {"type": "string", "minLength": 1, "maxLength": 90},
    "subtitle": {"type": "string", "minLength": 1, "maxLength": 180},
    "recipient": {"type": "string", "minLength": 1, "maxLength": 120},
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "content": {"type": "string", "minLength": 1, "maxLength": 200000},
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {"$ref": "#/$defs/section"}
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "components"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 90},
        "subtitle": {"type": "string", "minLength": 1, "maxLength": 180},
        "components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {"$ref": "#/$defs/component"}
        }
      }
    },
    "component": {
      "oneOf": [
        {"$ref": "#/$defs/text"},
        {"$ref": "#/$defs/metrics"},
        {"$ref": "#/$defs/highlights"},
        {"$ref": "#/$defs/cards"},
        {"$ref": "#/$defs/callout"},
        {"$ref": "#/$defs/comparison"},
        {"$ref": "#/$defs/chart"},
        {"$ref": "#/$defs/steps"},
        {"$ref": "#/$defs/timeline"},
        {"$ref": "#/$defs/table"},
        {"$ref": "#/$defs/investment"},
        {"$ref": "#/$defs/list"},
        {"$ref": "#/$defs/signature"}
      ]
    },
    "componentTitle": {"type": "string", "minLength": 1, "maxLength": 70},
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "content"],
      "properties": {
        "type": {"const": "text"},
        "title": {"$ref": "#/$defs/componentTitle"},
        "content": {"type": "string", "minLength": 1, "maxLength": 20000}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items"],
      "properties": {
        "type": {"const": "metrics"},
        "title": {"$ref": "#/$defs/componentTitle"},
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {"$ref": "#/$defs/metricItem"}
        }
      }
    },
    "metricItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value"],
      "properties": {
        "label": {"type": "string", "minLength": 1, "maxLength": 50},
        "value": {"type": "string", "minLength": 1, "maxLength": 32},
        "note": {"type": "string", "minLength": 1, "maxLength": 120}
      }
    },
    "highlights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items"],
      "properties": {
        "type": {"const": "highlights"},
        "title": {"$ref": "#/$defs/componentTitle"},
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {"type": "string", "minLength": 1, "maxLength": 350}
        }
      }
    },
    "cards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items"],
      "properties": {
        "type": {"const": "cards"},
        "title": {"$ref": "#/$defs/componentTitle"},
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {"$ref": "#/$defs/cardItem"}
        }
      }
    },
    "cardItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 70},
        "description": {"type": "string", "minLength": 1, "maxLength": 600},
        "tag": {"type": "string", "minLength": 1, "maxLength": 24}
      }
    },
    "callout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "content"],
      "properties": {
        "type": {"const": "callout"},
        "title": {"$ref": "#/$defs/componentTitle"},
        "content": {"type": "string", "minLength": 1, "maxLength": 1200}
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "left_label", "right_label", "rows"],
      "properties": {
        "type": {"const": "comparison"},
        "title": {"$ref": "#/$defs/componentTitle"},
        "left_label": {"type": "string", "minLength": 1, "maxLength": 45},
        "right_label": {"type": "string", "minLength": 1, "maxLength": 45},
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {"$ref": "#/$defs/comparisonRow"}
        }
      }
    },
    "comparisonRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "left", "right"],
      "properties": {
        "label": {"type": "string", "minLength": 1, "maxLength": 80},
        "left": {"type": "string", "minLength": 1, "maxLength": 300},
        "right": {"type": "string", "minLength": 1, "maxLength": 300}
      }
    },
    "chart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items"],
      "properties": {
        "type": {"const": "chart"},
        "title": {"$ref": "#/$defs/componentTitle"},
        "unit": {"type": "string", "minLength": 1, "maxLength": 16},
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {"$ref": "#/$defs/chartItem"}
        }
      }
    },
    "chartItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value"],
      "properties": {
        "label": {"type": "string", "minLength": 1, "maxLength": 50},
        "value": {"type": "number", "minimum": 0, "maximum": 1000000000000},
        "note": {"type": "string", "minLength": 1, "maxLength": 100}
      }
    },
    "steps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items"],
      "properties": {
        "type": {"const": "steps"},
        "title": {"$ref": "#/$defs/componentTitle"},
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 18,
          "items": {"$ref": "#/$defs/stepItem"}
        }
      }
    },
    "stepItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 70},
        "description": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items"],
      "properties": {
        "type": {"const": "timeline"},
        "title": {"$ref": "#/$defs/componentTitle"},
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 21,
          "items": {"$ref": "#/$defs/timelineItem"}
        }
      }
    },
    "timelineItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["period", "title"],
      "properties": {
        "period": {"type": "string", "minLength": 1, "maxLength": 40},
        "title": {"type": "string", "minLength": 1, "maxLength": 70},
        "description": {"type": "string", "minLength": 1, "maxLength": 350}
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "columns", "rows"],
      "properties": {
        "type": {"const": "table"},
        "title": {"$ref": "#/$defs/componentTitle"},
        "columns": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {"type": "string", "minLength": 1, "maxLength": 60}
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 6,
            "items": {
              "oneOf": [
                {"type": "string", "maxLength": 240},
                {"type": "number"}
              ]
            }
          }
        }
      }
    },
    "investment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items"],
      "properties": {
        "type": {"const": "investment"},
        "title": {"$ref": "#/$defs/componentTitle"},
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {"$ref": "#/$defs/investmentItem"}
        },
        "total": {"$ref": "#/$defs/investmentTotal"},
        "notes": {
          "type": "array",
          "maxItems": 8,
          "items": {"type": "string", "minLength": 1, "maxLength": 300}
        }
      }
    },
    "investmentItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value"],
      "properties": {
        "label": {"type": "string", "minLength": 1, "maxLength": 80},
        "value": {"type": "string", "minLength": 1, "maxLength": 50},
        "description": {"type": "string", "minLength": 1, "maxLength": 300}
      }
    },
    "investmentTotal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value"],
      "properties": {
        "label": {"type": "string", "minLength": 1, "maxLength": 80},
        "value": {"type": "string", "minLength": 1, "maxLength": 50}
      }
    },
    "list": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items"],
      "properties": {
        "type": {"const": "list"},
        "title": {"$ref": "#/$defs/componentTitle"},
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 60,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "signers"],
      "properties": {
        "type": {"const": "signature"},
        "title": {"$ref": "#/$defs/componentTitle"},
        "intro": {"type": "string", "minLength": 1, "maxLength": 300},
        "signers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {"$ref": "#/$defs/signer"}
        }
      }
    },
    "signer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 120},
        "role": {"type": "string", "minLength": 1, "maxLength": 120},
        "organization": {"type": "string", "minLength": 1, "maxLength": 120},
        "identifier": {"type": "string", "minLength": 1, "maxLength": 120}
      }
    }
  }
}
